{
  "branches": ["main"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    "@semantic-release/npm",
    ["@semantic-release/exec", { "prepareCmd": "bun run build:all" }],
    [
      "@semantic-release/git",
      {
        "assets": ["package.json"],
        "message": "chore(release): ${nextRelease.version} [skip ci]"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "dist/pbctl-linux-x64",
            "label": "pbctl linux x64"
          },
          {
            "path": "dist/pbctl-linux-arm64",
            "label": "pbctl linux arm64"
          },
          {
            "path": "dist/pbctl-darwin-x64",
            "label": "pbctl macos x64"
          },
          {
            "path": "dist/pbctl-darwin-arm64",
            "label": "pbctl macos arm64"
          },
          {
            "path": "install-pbctl.sh",
            "label": "install script"
          }
        ]
      }
    ]
  ]
}
