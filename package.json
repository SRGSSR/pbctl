{
  "name": "@srgssr/pbctl",
  "version": "0.1.0",
  "description": "An interactive terminal client for the pillarbox-demo-backend REST API",
  "license": "MIT",
  "author": "SRG SSR",
  "homepage": "https://github.com/srgssr/pbctl#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/srgssr/pbctl.git"
  },
  "bugs": {
    "url": "https://github.com/srgssr/pbctl/issues"
  },
  "keywords": [
    "pillarbox",
    "tui",
    "ink"
  ],
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "pbctl": "dist/index.js"
  },
  "files": [
    "dist/index.js",
    "docs"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun run src/index.tsx",
    "lint": "biome check .",
    "format": "biome format --write .",
    "arch": "depcruise src scripts --config .dependency-cruiser.cjs",
    "knip": "knip",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:coverage": "bun test --coverage --coverage-reporter=lcov --coverage-dir=coverage",
    "build": "bun build src/index.tsx --compile --outfile dist/pbctl",
    "build:npm": "bun build src/index.tsx --target=node --banner '#!/usr/bin/env node' --outfile dist/index.js",
    "build:all": "bun run scripts/build.ts",
    "verify": "bun run lint && bun run arch && bun run knip && bun run typecheck && bun run test && bun run build",
    "prepare": "husky",
    "prepack": "bun run build:npm"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@types/bun": "1.3.14",
    "@types/react": "^19.2.18",
    "dependency-cruiser": "^18.1.1",
    "husky": "^9.1.7",
    "knip": "^6.31.0",
    "react-devtools-core": "^7.0.1",
    "semantic-release": "^25.0.9",
    "typescript": "^6"
  },
  "dependencies": {
    "ink": "^7.1.1",
    "inkstand": "^0.2.0",
    "react": "^19.2.8"
  }
}
